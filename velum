<script>
  // Açılış Animasyonu (1.5 saniye sonra Splash kaybolur)
  window.addEventListener('load', () => {
    setTimeout(() => {
      document.getElementById('splash').classList.add('hide');
    }, 1500);
  });

  // Giriş / Kayıt Ekranları Arası Geçiş
  function toggleAuthMode(mode) {
    if(mode === 'login') {
      document.getElementById('registerView').classList.remove('active');
      document.getElementById('loginView').classList.add('active');
    } else {
      document.getElementById('loginView').classList.remove('active');
      document.getElementById('registerView').classList.add('active');
    }
  }

  // Giriş/Kayıt tamamlandığında ana uygulamaya geçiş
  function completeAuth() {
    document.getElementById('registerView').classList.remove('active');
    document.getElementById('loginView').classList.remove('active');
    document.getElementById('appContainer').classList.add('active');
  }

  // Sekme Geçişleri
  function showView(id, btn){
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    if(btn) btn.classList.add('active');

    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('on'));
    const idx = {feed:0, discover:1, search:2, profile:3}[id];
    if(document.querySelectorAll('.nav-item')[idx]) {
      document.querySelectorAll('.nav-item')[idx].classList.add('on');
    }
  }
</script>

