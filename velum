<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Velum — Tam Önizleme</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');

  :root{
    --ink:#14181C;
    --ink-2:#1D2329;
    --ink-3:#242B32;
    --paper:#F0EBE0;
    --paper-dim:#B8B0A0;
    --amber:#E8A33D;
    --amber-dim:#8A6528;
    --teal:#4C7C76;
    --rose:#B85C5C;
    --line:#2A3138;
    --super:#5B8FD9;
  }

  *{box-sizing:border-box;}
  body{
    margin:0;
    min-height:100vh;
    background:
      radial-gradient(circle at 20% 10%, #1a2128 0%, transparent 45%),
      radial-gradient(circle at 80% 90%, #1a2128 0%, transparent 45%),
      var(--ink);
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:48px 20px;
    font-family:'IBM Plex Sans', sans-serif;
    color:var(--paper);
  }

  .stage{display:flex; flex-direction:column; align-items:center; gap:22px;}
  .stage-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px; letter-spacing:0.18em; text-transform:uppercase; color:var(--paper-dim);
  }

  .phone{
    position:relative; width:368px; background:var(--ink-2);
    border-radius:34px; padding:14px 10px;
    box-shadow:0 40px 80px -20px rgba(0,0,0,0.7), 0 0 0 1px var(--line);
  }
  .sprockets{position:absolute; top:14px; bottom:14px; width:10px; display:flex; flex-direction:column; justify-content:space-between;}
  .sprockets.left{left:-2px;} .sprockets.right{right:-2px;}
  .sprocket-hole{width:6px;height:9px;background:var(--ink);border-radius:2px;margin:0 auto;}

  .screen{
    background:var(--ink); border-radius:24px; overflow:hidden;
    height:760px; display:flex; flex-direction:column; position:relative;
  }

  /* --- SPLASH EKRANI --- */
  #splash{
    position:absolute; inset:0; background:var(--ink); z-index:100;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    transition:opacity 0.6s ease, visibility 0.6s ease;
  }
  #splash.hide{opacity:0; visibility:hidden;}
  .splash-logo{
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:36px; letter-spacing:-0.02em;
    animation: pulseLogo 1.5s infinite alternate;
  }
  .splash-logo span{color:var(--amber);}
  .splash-sub{font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--paper-dim); letter-spacing:0.15em; text-transform:uppercase; margin-top:8px;}
  @keyframes pulseLogo{0%{transform:scale(1); opacity:0.8;} 100%{transform:scale(1.05); opacity:1;}}

  /* --- AUTH (GİRİŞ/KAYIT) EKRANI --- */
  .auth-view{
    position:absolute; inset:0; background:var(--ink); z-index:50; display:none;
    flex-direction:column; padding:24px 20px; overflow-y:auto;
  }
  .auth-view.active{display:flex;}
  .auth-header{text-align:center; margin:30px 0 24px;}
  .auth-title{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:20px; margin-top:10px;}
  .auth-desc{font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--paper-dim); margin-top:4px;}
  
  .auth-form{display:flex; flex-direction:column; gap:12px;}
  .auth-input-wrap{position:relative;}
  .auth-input{
    width:100%; background:var(--ink-2); border:1px solid var(--line); border-radius:12px;
    padding:13px 15px 13px 40px; color:var(--paper); font-family:'IBM Plex Sans', sans-serif; font-size:13px; outline:none;
    transition:border-color 0.2s;
  }
  .auth-input:focus{border-color:var(--amber);}
  .auth-input-icon{position:absolute; left:14px; top:14px; width:16px; height:16px; color:var(--paper-dim);}
  
  .auth-btn{
    width:100%; background:var(--amber); color:var(--ink); font-family:'Space Grotesk', sans-serif;
    font-weight:700; font-size:14px; padding:13px; border-radius:12px; border:none; cursor:pointer; margin-top:6px;
    transition:opacity 0.2s;
  }
  .auth-btn:hover{opacity:0.9;}
  .auth-switch{text-align:center; font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--paper-dim); margin-top:16px; cursor:pointer;}
  .auth-switch span{color:var(--amber); font-weight:600;}

  /* --- UYGULAMA İÇİ YAPI --- */
  .app-container{display:none; flex-direction:column; height:100%; position:relative;}
  .app-container.active{display:flex;}

  .topbar{display:flex; align-items:center; justify-content:space-between; padding:18px 18px 10px;}
  .brand{display:flex; align-items:baseline; gap:6px;}
  .brand-mark{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:19px; letter-spacing:-0.01em;}
  .brand-mark span{color:var(--amber);}
  .top-icons{display:flex; gap:14px; align-items:center;}
  .icon-btn{width:20px;height:20px;color:var(--paper-dim); cursor:pointer;}

  /* STORIES ROW */
  .stories-row{display:flex; gap:12px; padding:6px 18px 16px; overflow-x:auto;}
  .story-item{display:flex; flex-direction:column; align-items:center; gap:5px; flex-shrink:0;}
  .story-ring{
    width:56px;height:56px;border-radius:50%;
    background:linear-gradient(135deg, var(--amber), var(--rose));
    padding:2px; display:flex; align-items:center; justify-content:center;
  }
  .story-ring.seen{background:var(--line);}
  .story-ring.self{background:var(--line);}
  .story-avatar{width:100%;height:100%;border-radius:50%;background:linear-gradient(135deg,#3a4148,#21262c); display:flex;align-items:center;justify-content:center; font-size:16px;}
  .story-label{font-size:9.5px; color:var(--paper-dim); font-family:'IBM Plex Mono', monospace;}

  .tabbar{display:flex; gap:6px; padding:0 18px 14px;}
  .tab{
    font-family:'IBM Plex Mono', monospace; font-size:10.5px; letter-spacing:0.05em;
    padding:7px 12px; border-radius:100px; border:1px solid var(--line); color:var(--paper-dim);
    cursor:pointer; background:transparent; transition:all .15s ease;
  }
  .tab.active{background:var(--amber); border-color:var(--amber); color:var(--ink); font-weight:600;}

  .view{display:none; flex:1; overflow-y:auto; padding-bottom:88px;}
  .view.active{display:block;}
  .view::-webkit-scrollbar{display:none;}

  /* ---------- FEED ---------- */
  .post{padding:0 18px 22px;}
  .post-author{display:flex; align-items:center; gap:9px; margin-bottom:10px;}
  .post-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#3a4148,#21262c); border:1px solid var(--line);}
  .post-uname{font-size:12.5px; font-weight:600; display:flex; align-items:center; gap:5px;}
  .verified{
    width:13px;height:13px;border-radius:50%;background:var(--amber);
    display:inline-flex;align-items:center;justify-content:center;font-size:8px;color:var(--ink);font-weight:700;
  }
  .post-meta{font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--paper-dim);}

  .post-photo{
    width:100%; aspect-ratio:4/5; border-radius:14px;
    background:linear-gradient(160deg, #3a4a52 0%, #232b30 55%, #14181C 100%);
    position:relative; overflow:hidden; margin-bottom:10px;
  }
  .post-photo::after{content:""; position:absolute; inset:0; background:repeating-linear-gradient(115deg, rgba(255,255,255,0.03) 0 2px, transparent 2px 6px);}
  .photo-tag{position:absolute; top:12px; left:12px; font-family:'IBM Plex Mono', monospace; font-size:10px; background:rgba(20,24,28,0.7); backdrop-filter:blur(4px); padding:4px 9px; border-radius:100px; color:var(--paper-dim); letter-spacing:0.05em;}

  .action-row{display:flex; align-items:center; gap:14px; margin-bottom:12px;}
  .action-btn{display:flex; align-items:center; gap:5px; font-size:12px; color:var(--paper-dim); cursor:pointer;}
  .action-btn svg{width:19px;height:19px;}
  .action-btn.super{color:var(--super);}
  .action-count{font-family:'IBM Plex Mono', monospace; font-size:11px;}

  .why-box{background:var(--ink-2); border:1px solid var(--line); border-radius:12px; padding:12px 14px; margin-bottom:16px;}
  .why-label{font-family:'IBM Plex Mono', monospace; font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--amber); margin-bottom:5px;}
  .why-text{font-size:13px; line-height:1.5; color:var(--paper-dim);}

  .section-label{font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:14px; margin-bottom:12px; display:flex; align-items:center; gap:8px;}
  .section-label::before{content:""; width:3px; height:14px; background:var(--amber); border-radius:2px;}

  .feedback-card{background:var(--ink-2); border:1px solid var(--line); border-radius:12px; padding:13px 14px; margin-bottom:10px;}
  .fb-head{display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;}
  .fb-identity{display:flex; align-items:center; gap:8px;}
  .fb-avatar{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,#3a4148,#21262c); border:1px solid var(--line);}
  .fb-uname{font-size:11.5px; font-weight:600; display:flex; align-items:center; gap:4px;}
  .fb-badge{font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--amber); background:rgba(232,163,61,0.12); padding:3px 8px; border-radius:100px; letter-spacing:0.03em;}
  .fb-time{font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--paper-dim);}
  .fb-row{font-size:12.5px; line-height:1.5; margin-bottom:4px;}
  .fb-row b{color:var(--teal); font-weight:600;}
  .fb-row.improve b{color:var(--rose);}
  .fb-helpful{display:flex; gap:10px; margin-top:8px;}
  .helpful-btn{font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--paper-dim); border:1px solid var(--line); padding:4px 9px; border-radius:100px;}

  .sponsored-card{
    margin:0 18px 20px; padding:14px; border-radius:12px;
    background:var(--ink-2); border:1px dashed var(--line);
    display:flex; gap:12px; align-items:center;
  }
  .sponsored-thumb{width:44px;height:44px;border-radius:8px;background:linear-gradient(135deg,#3a4148,#21262c); flex-shrink:0;}
  .sponsored-text{font-size:11.5px; line-height:1.4; color:var(--paper-dim);}
  .sponsored-tag{font-family:'IBM Plex Mono', monospace; font-size:8.5px; color:var(--amber); letter-spacing:0.08em; margin-bottom:3px;}

  /* ---------- KEŞFET ---------- */
  .theme-banner{
    margin:0 18px 18px; padding:16px; border-radius:14px;
    background:linear-gradient(135deg, var(--ink-3), var(--ink-2));
    border:1px solid var(--line);
  }
  .theme-label{font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--amber); letter-spacing:0.1em; margin-bottom:5px;}
  .theme-title{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:17px; margin-bottom:4px;}
  .theme-countdown{font-family:'IBM Plex Mono', monospace; font-size:10.5px; color:var(--paper-dim);}

  .discover-grid{padding:0 18px; display:grid; grid-template-columns:repeat(3, 1fr); gap:8px;}
  .discover-tile{aspect-ratio:1; border-radius:10px; background:linear-gradient(160deg, #3a4a52 0%, #232b30 55%, #14181C 100%); position:relative; overflow:hidden;}
  .discover-tile.new::before{
    content:"YENİ"; position:absolute; top:6px; left:6px;
    font-family:'IBM Plex Mono', monospace; font-size:7.5px; background:var(--teal); color:var(--paper); padding:2px 6px; border-radius:100px; letter-spacing:0.05em;
  }
  .discover-sub{padding:18px 18px 10px; font-size:11.5px; color:var(--paper-dim); line-height:1.5;}

  /* ---------- ARAMA ---------- */
  .search-bar{margin:0 18px 16px; display:flex; align-items:center; gap:8px; background:var(--ink-2); border:1px solid var(--line); border-radius:100px; padding:11px 15px;}
  .search-bar svg{width:16px;height:16px; color:var(--paper-dim); flex-shrink:0;}
  .search-input-fake{font-size:12.5px; color:var(--paper-dim); font-family:'IBM Plex Sans', sans-serif;}
  .tag-row{display:flex; gap:8px; padding:0 18px 16px; flex-wrap:wrap;}
  .tag-chip{font-family:'IBM Plex Mono', monospace; font-size:10.5px; padding:6px 12px; border-radius:100px; border:1px solid var(--line); color:var(--paper-dim);}
  .tag-chip.active{background:var(--teal); border-color:var(--teal); color:var(--paper);}
  .result-row{display:flex; align-items:center; gap:11px; padding:10px 18px;}
  .result-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#3a4148,#21262c); border:1px solid var(--line);}
  .result-name{font-size:12.5px; font-weight:600; display:flex; align-items:center; gap:5px;}
  .result-sub{font-family:'IBM Plex Mono', monospace; font-size:9.5px; color:var(--paper-dim); margin-top:2px;}

  /* ---------- PROFİL ---------- */
  .profile-head{padding:8px 18px 16px; text-align:center;}
  .avatar-blind{width:68px;height:68px;border-radius:50%;margin:0 auto 10px;background:linear-gradient(135deg,#3a4148,#21262c); border:1px solid var(--line); position:relative;}
  .avatar-blind::after{content:"?"; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:'Space Grotesk', sans-serif; font-size:22px; color:var(--paper-dim);}
  .anon-name{font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:16px; margin-top:2px; display:flex; align-items:center; justify-content:center; gap:6px;}
  .anon-tag{font-family:'IBM Plex Mono', monospace; font-size:10px; color:var(--paper-dim); letter-spacing:0.06em; margin-top:3px;}

  .stat-row{display:flex; justify-content:center; gap:26px; padding:14px 0 18px;}
  .stat{text-align:center;}
  .stat-num{font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:15px;}
  .stat-lbl{font-family:'IBM Plex Mono', monospace; font-size:9px; color:var(--paper-dim); letter-spacing:0.05em; margin-top:2px;}

  .upgrade-card{
    margin:0 18px 18px; padding:14px; border-radius:12px;
    background:linear-gradient(135deg, rgba(232,163,61,0.14), rgba(232,163,61,0.04));
    border:1px solid var(--amber-dim);
    display:flex; align-items:center; justify-content:space-between; gap:10px;
  }
  .upgrade-text{font-size:11.5px; line-height:1.4;}
  .upgrade-text b{color:var(--amber); display:block; font-size:12.5px; margin-bottom:2px;}
  .upgrade-btn{font-family:'IBM Plex Mono', monospace; font-size:10px; background:var(--amber); color:var(--ink); padding:8px 12px; border-radius:100px; font-weight:600; white-space:nowrap; cursor:pointer;}

  .progress-wrap{padding:0 18px 20px;}
  .progress-card{background:var(--ink-2); border:1px solid var(--line); border-radius:12px; padding:14px;}
  .progress-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;}
  .progress-title{font-size:12.5px; font-weight:600;}
  .progress-meta{font-family:'IBM Plex Mono', monospace; font-size:10px; color:var(--amber);}
  .progress-track{height:6px; background:var(--ink); border-radius:100px; overflow:hidden;}
  .progress-fill{height:100%; width:72%; background:linear-gradient(90deg, var(--amber-dim), var(--amber)); border-radius:100px;}

  .badge-grid{padding:0 18px 18px; display:grid; grid-template-columns:repeat(3, 1fr); gap:10px;}
  .badge-frame{aspect-ratio:1; background:var(--ink-2); border:1px solid var(--line); border-radius:10px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; position:relative; padding:8px; text-align:center;}
  .badge-frame.locked{opacity:0.35;}
  .badge-frame::before{content:attr(data-n); position:absolute; top:6px; left:8px; font-family:'IBM Plex Mono', monospace; font-size:8px; color:var(--paper-dim);}
  .badge-icon{font-size:20px;}
  .badge-name{font-size:9px; font-weight:500; line-height:1.3; color:var(--paper-dim);}

  .msg-note{margin:0 18px; padding:12px 14px; border-radius:12px; background:var(--ink-2); border:1px solid var(--line); font-size:11px; color:var(--paper-dim); line-height:1.5; display:flex; gap:8px; align-items:flex-start;}
  .msg-note svg{width:14px;height:14px; flex-shrink:0; margin-top:1px; color:var(--teal);}

  .bottomnav{position:absolute; bottom:0; left:0; right:0; background:linear-gradient(0deg, var(--ink) 65%, transparent); padding:20px 24px 16px; display:flex; justify-content:space-between;}
  .nav-item{display:flex; flex-direction:column; align-items:center; gap:4px; cursor:pointer;}
  .nav-dot{width:20px;height:20px; border-radius:6px; background:var(--line);}
  .nav-item.on .nav-dot{background:var(--amber);}
  .nav-txt{font-family:'IBM Plex Mono', monospace; font-size:8px; color:var(--paper-dim); letter-spacing:0.04em;}
  .nav-item.on .nav-txt{color:var(--amber);}

  .caption{max-width:368px; text-align:center; font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--paper-dim); line-height:1.6;}
  .caption b{color:var(--amber); font-weight:500;}
</style>
</head>
<body>

<div class="stage">
  <div class="stage-label">Velum — Sistem Önizleme</div>

  <div class="phone">
    <div class="sprockets left">
      <div class="sprocket-hole"></div><div class="sprocket-hole"></div><div class="sprocket-hole"></div>
      <div class="sprocket-hole"></div><div class="sprocket-hole"></div><div class="sprocket-hole"></div>
      <div class="sprocket-hole"></div><div class="sprocket-hole"></div>
    </div>
    <div class="sprockets right">
      <div class="sprocket-hole"></div><div class="sprocket-hole"></div><div class="sprocket-hole"></div>
      <div class="sprocket-hole"></div><div class="sprocket-hole"></div><div class="sprocket-hole"></div>
      <div class="sprocket-hole"></div><div class="sprocket-hole"></div>
    </div>

    <div class="screen">
      <!-- SPLASH EKRANI -->
      <div id="splash">
        <div class="splash-logo">vel<span>um</span></div>
        <div class="splash-sub">Kimlik Gizli · İtibar Görünür</div>
      </div>

      <!-- KAYIT OL EKRANI -->
      <div class="auth-view active" id="registerView">
        <div class="auth-header">
          <div class="avatar-blind" style="margin:0 auto 10px;"></div>
          <div class="auth-title">İlk Kareni Oluştur</div>
          <div class="auth-desc">Anonim kimliğinle aramıza katıl</div>
        </div>
        <div class="auth-form">
          <div class="auth-input-wrap">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" class="auth-input" placeholder="Kullanıcı Adı Belirle">
          </div>
          <div class="auth-input-wrap">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <input type="email" class="auth-input" placeholder="E-posta Adresi">
          </div>
          <div class="auth-input-wrap">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" class="auth-input" placeholder="Parola">
          </div>
          <button class="auth-btn" onclick="completeAuth()">KAYIT OL</button>
        </div>
        <div class="auth-switch" onclick="toggleAuthMode('login')">
          Zaten hesabın var mı? <span>Giriş Yap</span>
        </div>
      </div>

      <!-- GİRİŞ YAP EKRANI -->
      <div class="auth-view" id="loginView">
        <div class="auth-header" style="margin-top:50px;">
          <div class="splash-logo" style="font-size:28px;">vel<span>um</span></div>
          <div class="auth-title" style="margin-top:15px;">Tekrar Hoş Geldin</div>
          <div class="auth-desc">Karelerine ve itibarına kaldığın yerden devam et</div>
        </div>
        <div class="auth-form">
          <div class="auth-input-wrap">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <input type="email" class="auth-input" placeholder="E-posta Adresi">
          </div>
          <div class="auth-input-wrap">
            <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" class="auth-input" placeholder="Parola">
          </div>
          <button class="auth-btn" onclick="completeAuth()">GİRİŞ YAP</button>
        </div>
        <div class="auth-switch" onclick="toggleAuthMode('register')">
          Hesabın yok mu? <span>Kayıt Ol</span>
        </div>
      </div>

      <!-- ANA UYGULAMA İÇERİĞİ -->
      <div class="app-container" id="appContainer">
        <div class="topbar">
